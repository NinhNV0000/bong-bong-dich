<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <View
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="118dp"
        android:layout_marginEnd="-78dp"
        android:background="@drawable/bg_blob" />

    <View
        android:layout_width="118dp"
        android:layout_height="118dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-52dp"
        android:layout_marginBottom="78dp"
        android:background="@drawable/bg_blob" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/button_glossary_top"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_round_white"
                    android:contentDescription="@string/glossary_title"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:text="⚙"
                    android:textColor="@color/text_primary"
                    android:textSize="23sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/button_info"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_round_white"
                    android:contentDescription="@string/info"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="@color/text_primary"
                    android:textSize="23sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="154dp"
                android:layout_height="112dp"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:gravity="center"
                    android:rotation="-18"
                    android:text="↻"
                    android:textColor="@color/primary"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="11dp"
                    android:background="@drawable/bg_logo_card_white"
                    android:elevation="8dp"
                    android:gravity="center"
                    android:rotation="-4"
                    android:text="中"
                    android:textColor="@color/text_primary"
                    android:textSize="39sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_logo_card_blue"
                    android:elevation="11dp"
                    android:gravity="center"
                    android:rotation="3"
                    android:text="Việt"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_title_prefix"
                    android:textColor="@color/text_primary"
                    android:textSize="31sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_title_highlight"
                    android:textColor="@color/primary"
                    android:textSize="31sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="@string/app_subtitle_short"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_language_pill"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:text="@string/language_source"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⇄"
                    android:textColor="@color/text_primary"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_language_pill"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:text="@string/language_target"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="242dp"
                android:layout_height="242dp"
                android:layout_marginTop="26dp">

                <View
                    android:layout_width="242dp"
                    android:layout_height="242dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_power_ring_outer" />

                <View
                    android:layout_width="218dp"
                    android:layout_height="218dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_power_ring_mid" />

                <FrameLayout
                    android:id="@+id/button_start"
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_power_button"
                    android:clickable="true"
                    android:contentDescription="@string/button_start"
                    android:elevation="13dp"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:layout_gravity="top"
                        android:layout_marginTop="35dp"
                        android:gravity="center"
                        android:text="▶"
                        android:textColor="@android:color/white"
                        android:textSize="42sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="43dp"
                        android:gravity="center"
                        android:text="@string/button_start_short"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="@string/status_off"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/button_glossary"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:elevation="5dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_status"
                    android:gravity="center"
                    android:text="词"
                    android:textColor="@color/primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/glossary_title"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/glossary_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/text_secondary"
                    android:textSize="34sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/button_stop"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_language_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/button_stop"
                android:textColor="@color/danger"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/made_for"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

